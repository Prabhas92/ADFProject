										"expression": {
											"value": "@greater(\r\n    activity('New_LookUp_Col').output.firstRow.NewWatermarkValue,\r\n    activity('Old_LookUp_Col').output.firstRow.WatermarkValue\r\n)",
											"type": "Expression"
										},
