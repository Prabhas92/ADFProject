													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "SqlServerSource",
														"sqlReaderQuery": {
															"value": "@concat(\n'SELECT * FROM ',\nitem().TableSchemaName,\n'.',\nitem().TableName,\n' WHERE ',\nitem().WaterMark_Column,\n' > ''',\nformatDateTime(activity('Old_LookUp_Col').output.firstRow.WatermarkValue,'yyyy-MM-dd HH:mm:ss'),\n''' AND ',\nitem().WaterMark_Column,\n' <= ''',\nformatDateTime(activity('New_LookUp_Col').output.firstRow.NewWatermarkValue,'yyyy-MM-dd HH:mm:ss'),\n''''\n)",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "AzureSqlSink",
