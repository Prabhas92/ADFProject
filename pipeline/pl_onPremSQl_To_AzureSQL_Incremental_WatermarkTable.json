{
	"name": "pl_onPremSQl_To_AzureSQL_Incremental_WatermarkTable",
	"properties": {
		"activities": [
			{
				"name": "ForEachTableName",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.TableList",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Old_LookUp_Col",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "SELECT WatermarkValue \nFROM watermarktable \nWHERE TableName = '@{item().TableName}';",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_OnPrem_OldLookUp",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "New_LookUp_Col",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "SELECT MAX(last_updated) AS NewWatermarkValue \nFROM @{item().TableName}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_OnPrem_NewLookUp",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Old_LookUp_Col",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "New_LookUp_Col",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(\r\n    activity('New_LookUp_Col').output.firstRow.NewWatermarkValue,\r\n    activity('Old_LookUp_Col').output.firstRow.WatermarkValue\r\n)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Copy_FromOnPremSQL_ToAzureSQL",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "SqlServerSource",
												"sqlReaderQuery": {
													"value": "@concat(\n'SELECT * FROM ',\nitem().TableSchemaName,\n'.',\nitem().TableName,\n' WHERE ',\nitem().WaterMark_Column,\n' > ''',\nformatDateTime(activity('Old_LookUp_Col').output.firstRow.WatermarkValue,'yyyy-MM-dd HH:mm:ss'),\n''' AND ',\nitem().WaterMark_Column,\n' <= ''',\nformatDateTime(activity('New_LookUp_Col').output.firstRow.NewWatermarkValue,'yyyy-MM-dd HH:mm:ss'),\n''''\n)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "AzureSqlSink",
												"writeBehavior": "upsert",
												"upsertSettings": {
													"useTempDB": true,
													"keys": [
														"id"
													]
												},
												"sqlWriterUseTableLock": false,
												"disableMetricsCollection": false
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "ds_OnPrem_SQL_Source",
												"type": "DatasetReference",
												"parameters": {
													"SchemaName": {
														"value": "@item().TableSchemaName",
														"type": "Expression"
													},
													"TableName": {
														"value": "@item().TableName",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "ds_Azure_SQL_Target",
												"type": "DatasetReference",
												"parameters": {
													"SchemaName": {
														"value": "@item().TableSchemaName",
														"type": "Expression"
													},
													"TableName": {
														"value": "@item().TableName",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "SP_Update_WaterMark",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Copy_FromOnPremSQL_ToAzureSQL",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[usp_write_watermark]",
											"storedProcedureParameters": {
												"last_updated": {
													"value": {
														"value": "@activity('New_LookUp_Col').output.firstRow.NewWatermarkValue",
														"type": "Expression"
													},
													"type": "DateTime"
												},
												"tableName": {
													"value": {
														"value": "@item().TableName",
														"type": "Expression"
													},
													"type": "String"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "ls_OnPrem_SQL_Server",
											"type": "LinkedServiceReference"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"TableList": {
				"type": "array",
				"defaultValue": [
					{
						"TableName": "iplteams",
						"TableSchemaName": "dbo",
						"WaterMark_Column": "last_updated"
					},
					{
						"TableName": "salesitems",
						"TableSchemaName": "dbo",
						"WaterMark_Column": "last_updated"
					}
				]
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-06-22T09:45:07Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}